# MongoDB Connection String (Local or Atlas)
MONGO_URI=mongodb://localhost:27017/whistledrop

# Server Port (Default: 5000)
PORT=5000

# Cryptographically Secure JWT Secret Key (Required)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# JWT Expiration Lifespan (Default: 24h)
JWT_EXPIRES_IN=24h

# Password used by the moderator seeding script (Required for createModerator.js)
MODERATOR_PASSWORD=your_initial_moderator_password_here

# Optional: Comma-separated whitelist of allowed browser origins for CORS (leave unset to block browser cross-origin requests)
# ALLOWED_ORIGINS=http://localhost:3000
